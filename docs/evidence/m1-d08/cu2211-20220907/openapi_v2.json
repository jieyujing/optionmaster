  "openapi": "3.1.0",
  "paths": {
    "/api/v2/research/coverage": {
      "get": {
        "operationId": "coverage_api_v2_research_coverage_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChainApiEnvelope"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChainApiEnvelope"
                }
              }
            },
            "description": "Bearer authentication required"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChainApiEnvelope"
                }
              }
            },
            "description": "Invalid request"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChainApiEnvelope"
                }
              }
            },
            "description": "Local computation busy"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChainApiEnvelope"
                }
              }
            },
            "description": "Internal computation failure"
          }
        },
        "security": [
          {
            "ResearchBearer": []
          }
        ],
        "summary": "Coverage"
      }
    },
    "/api/v2/research/valuations": {
      "post": {
        "operationId": "valuation_api_v2_research_valuations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "curve_price_shocks": {
                    "items": {
                      "maximum": 1.0,
                      "minimum": -1.0,
                      "type": "number"
                    },
                    "maxItems": 11,
                    "minItems": 1,
                    "title": "Curve Price Shocks",
                    "type": "array"
                  },
                  "heatmap_iv_shocks": {
                    "items": {
                      "maximum": 1.0,
                      "minimum": -1.0,
                      "type": "number"
                    },
                    "maxItems": 5,
                    "minItems": 1,
                    "title": "Heatmap Iv Shocks",
                    "type": "array"
                  },
                  "heatmap_price_shocks": {
                    "items": {
                      "maximum": 1.0,
                      "minimum": -1.0,
                      "type": "number"
                    },
                    "maxItems": 5,
                    "minItems": 1,
                    "title": "Heatmap Price Shocks",
                    "type": "array"
                  },
                  "positions": {
                    "additionalProperties": {
                      "maximum": 1000.0,
                      "minimum": -1000.0,
                      "type": "integer"
                    },
                    "maxProperties": 8,
                    "minProperties": 2,
                    "propertyNames": {
                      "maxLength": 128,
                      "minLength": 1
                    },
                    "title": "Positions",
                    "type": "object"
                  },
                  "scenario_at": {
                    "maxLength": 32,
                    "minLength": 25,
                    "title": "Scenario At",
                    "type": "string"
                  },
                  "schema_version": {
                    "const": "2.0",
                    "title": "Schema Version",
                    "type": "string"
                  },
                  "slice_id": {
                    "const": "shfe-cu2211-2022-09-07-chain-v2",
                    "title": "Slice Id",
                    "type": "string"
                  }
                },
                "required": [
                  "schema_version",
                  "slice_id",
                  "positions",
                  "scenario_at",
                  "curve_price_shocks",
                  "heatmap_price_shocks",
                  "heatmap_iv_shocks"
                ],
                "title": "ChainValuationRequestDTO",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChainApiEnvelope"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChainApiEnvelope"
                }
              }
            },
            "description": "Bearer authentication required"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChainApiEnvelope"
                }
              }
            },
            "description": "Content Too Large"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChainApiEnvelope"
                }
              }
            },
            "description": "Unsupported Media Type"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChainApiEnvelope"
                }
              }
            },
            "description": "Invalid request"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChainApiEnvelope"
                }
              }
            },
            "description": "Local computation busy"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChainApiEnvelope"
                }
              }
            },
            "description": "Internal computation failure"
          }
        },
        "security": [
          {
            "ResearchBearer": []
          }
        ],
        "summary": "Valuation"
      }
    }
  }
